    {
      "id": "pgjson-010",
      "category": "foundations",
      "level": "实践",
      "subtopic": "PostgreSQL JSON 数据",
      "knowledgePoint": "顶层合并",
      "questionType": "代码与配置",
      "origin": "自行整理",
      "question": "PostgreSQL 17 的两个 JSONB 对象使用 || 合并时，重复键和嵌套对象如何处理？",
      "answer": "重复顶层键取右侧值；合并不递归到嵌套对象。",
      "explanation": "右侧整个嵌套值会替换左侧同键的嵌套值。",
      "example": "'{\"a\":{\"x\":1}}'::jsonb || '{\"a\":{\"y\":2}}'::jsonb 只保留右侧 a 值。",
      "tags": [
        "PostgreSQL JSON 数据",
        "顶层合并"
      ],
      "evidence": "source",
      "reference": "https://www.postgresql.org/docs/17/functions-json.html"
    },
