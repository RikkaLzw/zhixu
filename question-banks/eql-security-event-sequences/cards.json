    {
      "id": "eqlsec-010",
      "category": "operations",
      "level": "进阶",
      "subtopic": "EQL 安全事件关联",
      "knowledgePoint": "无序样本",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "EQL sample 与 sequence 在时间顺序上有什么区别？",
      "answer": "sequence 按时间顺序匹配；sample 匹配共享关联键的事件组合，不要求时间顺序。",
      "explanation": "sample 也不支持 sequence 的 maxspan、runs 或 until。",
      "example": "按主机关联两类事件但不要求先后。",
      "tags": [
        "EQL 安全事件关联",
        "无序样本"
      ],
      "evidence": "source",
      "reference": "https://www.elastic.co/guide/en/elasticsearch/reference/8.17/eql-syntax.html"
    },
    {
