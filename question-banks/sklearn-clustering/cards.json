    {
      "id": "cluster-002",
      "category": "foundations",
      "level": "入门",
      "subtopic": "K-means",
      "knowledgePoint": "聚类中心",
      "questionType": "概念与原理",
      "question": "K-means 的聚类中心一定是原始样本吗？",
      "answer": "不一定；中心是所属样本在特征空间中的均值。",
      "explanation": "计算出的均值可能不与任何观测样本完全重合。",
      "example": "两个一维样本 0 和 2 的中心是 1。",
      "tags": [
        "聚类中心",
        "机器学习",
        "聚类"
      ],
      "evidence": "source",
