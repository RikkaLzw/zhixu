    {
      "id": "ocsfbase-007",
      "category": "detection",
      "level": "进阶",
      "subtopic": "安全事件标准化",
      "knowledgePoint": "处理时间",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "OCSF 1.2.0 的 metadata.processed_time 记录哪类时间？",
      "answer": "记录事件被处理的时间，例如 ETL 处理时间。",
      "explanation": "它不是事件实际发生时间的同义词。",
      "example": "日志标准化任务处理记录时写入处理时间。",
      "tags": [
        "安全事件标准化",
        "处理时间"
      ],
      "evidence": "source",
      "reference": "https://github.com/ocsf/ocsf-schema/blob/v1.2.0/dictionary.json"
