    {
      "id": "ocsfbase-002",
      "category": "detection",
      "level": "入门",
      "subtopic": "安全事件标准化",
      "knowledgePoint": "类别与类",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "OCSF 1.2.0 的 category_uid 与 class_uid 分别标识什么？",
      "answer": "category_uid 标识事件类别；class_uid 标识更具体的事件类。",
      "explanation": "类定义事件可使用的属性。",
      "example": "认证活动属于某个类别下的具体事件类。",
      "tags": [
        "安全事件标准化",
        "类别与类"
      ],
      "evidence": "source",
      "reference": "https://github.com/ocsf/ocsf-schema/blob/v1.2.0/dictionary.json"
    },
    {
      "id": "ocsfbase-003",
      "category": "detection",
      "level": "入门",
      "subtopic": "安全事件标准化",
      "knowledgePoint": "活动标识",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "OCSF 1.2.0 的 activity_id 表示什么？",
      "answer": "表示触发事件的活动的标准化标识。",
      "explanation": "各事件类可以定义自己的活动枚举。",
      "example": "认证事件可区分登录和注销活动。",
      "tags": [
        "安全事件标准化",
        "活动标识"
      ],
      "evidence": "source",
      "reference": "https://github.com/ocsf/ocsf-schema/blob/v1.2.0/dictionary.json"
    },
    {
      "id": "ocsfbase-004",
      "category": "detection",
      "level": "进阶",
      "subtopic": "安全事件标准化",
      "knowledgePoint": "类型标识",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "OCSF 1.2.0 的 type_uid 如何由事件类和活动标识计算？",
      "answer": "type_uid = class_uid × 100 + activity_id。",
      "explanation": "计算应使用同一事件的标准化标识。",
      "example": "类标识为 3002、活动标识为 1 时类型标识为 300201。",
      "tags": [
        "安全事件标准化",
        "类型标识"
      ],
      "evidence": "source",
      "reference": "https://github.com/ocsf/ocsf-schema/blob/v1.2.0/dictionary.json"
