    },
    {
      "id": "mlreg-005",
      "category": "foundations",
      "level": "入门",
      "subtopic": "MLflow 模型注册",
      "knowledgePoint": "删除别名",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "MLflow 删除注册模型的某个别名时，会同时删除其指向的模型版本吗？",
      "answer": "不会；删除别名只移除该命名引用。",
      "explanation": "模型版本仍可通过版本号查找。",
      "example": "移除 champion 后版本 2 仍存在。",
      "tags": [
        "MLflow 模型注册",
        "删除别名"
      ],
      "evidence": "source",
      "reference": "https://github.com/mlflow/mlflow/blob/v2.22.0/mlflow/tracking/client.py"
