    {
      "id": "faissapi-007",
      "category": "foundations",
      "level": "进阶",
      "subtopic": "Faiss 索引接口",
      "knowledgePoint": "索引向量总数",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "Faiss Index 的 ntotal 属性表示什么？",
      "answer": "表示索引中当前存储的向量总数。",
      "explanation": "它不是向量维数，也不是一次搜索请求的 k。",
      "example": "索引存入 100 条向量后可查看 ntotal。",
      "tags": [
        "索引向量总数",
        "Faiss 索引接口"
      ],
      "evidence": "source",
      "reference": "https://github.com/facebookresearch/faiss/blob/v1.12.0/faiss/Index.h"
