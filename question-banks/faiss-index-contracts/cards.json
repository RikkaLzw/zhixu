    {
      "id": "faissapi-004",
      "category": "foundations",
      "level": "进阶",
      "subtopic": "Faiss 索引接口",
      "knowledgePoint": "IDMap添加接口",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "Faiss 1.12 的 IndexIDMap 应使用 add 还是 add_with_ids 添加向量？",
      "answer": "使用 add_with_ids 并提供 ID；直接调用 add 会失败。",
      "explanation": "包装器维护外部 ID 与内部位置的映射。",
      "example": "添加向量时同时提供业务侧的整数 ID。",
      "tags": [
        "IDMap添加接口",
        "Faiss 索引接口"
      ],
      "evidence": "source",
      "reference": "https://github.com/facebookresearch/faiss/blob/v1.12.0/faiss/IndexIDMap.h"
    },
    {
      "id": "faissapi-005",
      "category": "foundations",
      "level": "进阶",
      "subtopic": "Faiss 索引接口",
      "knowledgePoint": "IDMap2重建",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "Faiss 1.12 的 IndexIDMap2 相比 IndexIDMap 为按外部 ID 重建提供了什么？",
      "answer": "它维护反向映射并实现按 ID 的重建；底层索引仍需支持相应重建能力。",
      "explanation": "映射解决外部 ID 到内部位置的定位。",
      "example": "用外部 ID 找到映射的位置并重建向量。",
      "tags": [
        "IDMap2重建",
        "Faiss 索引接口"
      ],
      "evidence": "source",
      "reference": "https://github.com/facebookresearch/faiss/blob/v1.12.0/faiss/IndexIDMap.h"
