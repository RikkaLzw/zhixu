    {
      "id": "skevalcl-005",
      "category": "foundations",
      "level": "进阶",
      "subtopic": "聚类评估指标",
      "knowledgePoint": "调整兰德",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "调整兰德指数 ARI 与未调整的 Rand 指数相比增加了什么？",
      "answer": "对随机划分得到的一致程度进行机会校正，使随机标签的期望分数接近 0。",
      "explanation": "完全一致时得 1，个别结果也可能小于 0。",
      "example": "比较聚类与已知类别时计算 adjusted_rand_score。",
      "tags": [
        "聚类评估指标",
        "调整兰德"
      ],
      "evidence": "source",
      "reference": "https://scikit-learn.org/1.7/modules/clustering.html#clustering-performance-evaluation"
