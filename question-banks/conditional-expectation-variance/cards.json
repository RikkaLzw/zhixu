    {
      "id": "condexp-002",
      "category": "foundations",
      "level": "进阶",
      "subtopic": "条件期望与方差",
      "knowledgePoint": "条件期望线性",
      "questionType": "计算与推导",
      "origin": "自行整理",
      "question": "期望存在时，E[aX+bZ|Y] 如何利用条件期望表示？",
      "answer": "等于 aE[X|Y]+bE[Z|Y]。",
      "explanation": "线性性质不要求 X 和 Z 独立。",
      "example": "若 a=2、b=1，可分别计算 X 与 Z 的条件期望再组合。",
      "tags": [
        "条件期望与方差",
        "条件期望线性"
      ],
      "evidence": "source",
      "reference": "https://www.probabilitycourse.com/chapter5/5_1_5_conditional_expectation.php"
    },
    {
      "id": "condexp-003",
      "category": "foundations",
      "level": "进阶",
      "subtopic": "条件期望与方差",
      "knowledgePoint": "已知量移出",
      "questionType": "计算与推导",
      "origin": "自行整理",
      "question": "在相关期望存在时，E[g(Y)X|Y] 可以怎样化简？",
      "answer": "等于 g(Y)E[X|Y]。",
      "explanation": "给定 Y 后，g(Y) 对条件期望来说已知。",
      "example": "E[YX|Y]=Y·E[X|Y]。",
      "tags": [
        "条件期望与方差",
        "已知量移出"
      ],
      "evidence": "source",
