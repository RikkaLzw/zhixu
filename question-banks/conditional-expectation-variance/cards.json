    {
      "id": "condexp-005",
      "category": "foundations",
      "level": "进阶",
      "subtopic": "条件期望与方差",
      "knowledgePoint": "全期望",
      "questionType": "计算与推导",
      "origin": "自行整理",
      "question": "期望存在时，全期望公式如何表达 E[X] 与 E[X|Y] 的关系？",
      "answer": "E[X]=E[E[X|Y]]。",
      "explanation": "先求每个条件下的期望，再按 Y 的分布取平均。",
      "example": "先计算各用户组的平均值，再按组比例加权求总体均值。",
      "tags": [
        "条件期望与方差",
        "全期望"
      ],
      "evidence": "source",
      "reference": "https://www.probabilitycourse.com/chapter5/5_1_5_conditional_expectation.php"
    },
