    {
      "id": "info-001",
      "category": "foundations",
      "level": "入门",
      "subtopic": "信息论",
      "knowledgePoint": "自信息",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "概率为 p 的事件发生时，自信息如何表示？",
      "answer": "当 0<p≤1 时，自信息为 −log₂p，单位是比特。",
      "explanation": "概率越小，自信息越大；概率为 1 的事件自信息为 0。",
      "example": "概率为 1/2 的事件携带 1 比特自信息。",
      "tags": [
        "自信息",
        "信息论"
      ],
      "evidence": "source",
      "reference": "https://d2l.ai/chapter_appendix-mathematics-for-deep-learning/information-theory.html"
    },
    {
      "id": "info-002",
      "category": "foundations",
      "level": "入门",
      "subtopic": "信息论",
      "knowledgePoint": "离散熵",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "离散随机变量的熵如何由各结果的概率计算？",
      "answer": "计算 −Σ p(x)log₂p(x)，即各结果自信息的期望。",
      "explanation": "约定概率为 0 的项贡献为 0。",
      "example": "等概率的两个结果对应 1 比特熵。",
      "tags": [
        "离散熵",
        "信息论"
      ],
      "evidence": "source",
      "reference": "https://d2l.ai/chapter_appendix-mathematics-for-deep-learning/information-theory.html"
    },
    {
      "id": "info-003",
      "category": "foundations",
      "level": "进阶",
      "subtopic": "信息论",
      "knowledgePoint": "有限离散熵上界",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "固定有限个可能结果时，什么分布达到最大的离散熵？",
      "answer": "各结果等概率的均匀分布达到最大熵。",
      "explanation": "最大值为 log₂n 比特，其中 n 是可能结果的个数。",
      "example": "四个等概率结果的熵为 2 比特。",
      "tags": [
        "有限离散熵上界",
        "信息论"
      ],
      "evidence": "source",
      "reference": "https://d2l.ai/chapter_appendix-mathematics-for-deep-learning/information-theory.html"
    },
    {
      "id": "info-004",
      "category": "foundations",
      "level": "进阶",
      "subtopic": "信息论",
      "knowledgePoint": "KL不对称",
      "questionType": "易错点",
      "origin": "自行整理",
      "question": "KL 散度 DKL(P‖Q) 交换 P 和 Q 后一般相同吗？",
      "answer": "不一定；KL 散度一般不对称。",
      "explanation": "因此它不满足度量距离所要求的对称性。",
      "example": "比较模型分布偏离参考分布时要保留散度方向。",
      "tags": [
        "KL不对称",
        "信息论"
      ],
      "evidence": "source",
      "reference": "https://d2l.ai/chapter_appendix-mathematics-for-deep-learning/information-theory.html"
    },
    {
      "id": "info-005",
      "category": "foundations",
      "level": "进阶",
      "subtopic": "信息论",
      "knowledgePoint": "KL支持集",
      "questionType": "易错点",
      "origin": "自行整理",
      "question": "离散分布中若 P(x)>0 而 Q(x)=0，DKL(P‖Q) 如何？",
      "answer": "该散度为正无穷。",
      "explanation": "Q 给 P 可能产生的结果分配零概率，会导致对数比值发散。",
      "example": "真实分布可能输出某结果，而模型认为其概率为零。",
      "tags": [
        "KL支持集",
        "信息论"
      ],
      "evidence": "source",
      "reference": "https://d2l.ai/chapter_appendix-mathematics-for-deep-learning/information-theory.html"
    },
    {
      "id": "info-006",
      "category": "foundations",
      "level": "进阶",
      "subtopic": "信息论",
      "knowledgePoint": "交叉熵与KL",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "交叉熵 CE(P,Q) 与 KL 散度 DKL(P‖Q) 有什么关系？",
      "answer": "CE(P,Q)=H(P)+DKL(P‖Q)；当 P 固定时，最小化交叉熵与最小化该 KL 散度对 Q 等价。",
      "explanation": "表达式中的散度方向不能随意交换；支持集不匹配时可能出现无穷值。",
      "example": "用固定标签分布 P 优化预测分布 Q。",
      "tags": [
        "交叉熵与KL",
        "信息论",
        "公开面经",
        "字节"
      ],
