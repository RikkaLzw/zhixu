    {
      "id": "copilot-004",
      "category": "operations",
      "level": "实践",
      "question": "AI 事件摘要如何让分析人员快速回查证据？",
      "answer": "对关键结论附带可定位的事件、资产或指标引用。",
      "explanation": "引用必须真正支持对应结论，而不仅是附上相关链接。",
      "example": "摘要中的可疑外联结论指向相应连接事件和目的地址。",
      "tags": [
        "证据引用",
        "可追溯"
      ],
      "evidence": "application",
      "subtopic": "事件摘要",
      "knowledgePoint": "结论的证据引用",
