    },
    {
      "id": "copilot-005",
      "category": "operations",
      "level": "进阶",
      "question": "为什么 AI 事件摘要要展示数据覆盖情况？",
      "answer": "缺少日志、资产信息或告警上下文时，摘要可能无法覆盖完整事件。",
      "explanation": "应标明输入范围、时间窗口和未获得的数据。",
      "example": "注明仅分析了某台主机近 24 小时的可用告警。",
      "tags": [
        "数据覆盖",
        "事件摘要"
      ],
      "evidence": "application",
      "subtopic": "事件摘要",
      "knowledgePoint": "摘要输入覆盖",
