    {
      "id": "rlmethod-004",
      "category": "foundations",
      "level": "进阶",
      "subtopic": "强化学习方法",
      "knowledgePoint": "经验转移概率",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "在表格型模型式学习中，如何用观察计数估计转移概率 P(s′|s,a)？",
      "answer": "用观察到 (s,a) 后转移到 s′ 的次数，除以观察到 (s,a) 的总次数。",
      "explanation": "未观察到的状态动作对不能直接用该比例估计。",
      "example": "某动作共观察 4 次，其中 3 次到达状态 D，经验概率为 3/4。",
      "tags": [
        "经验转移概率",
        "强化学习方法"
      ],
      "evidence": "source",
      "reference": "https://inst.eecs.berkeley.edu/~cs188/textbook/rl/mbl.html"
    },
    {
      "id": "rlmethod-005",
      "category": "foundations",
      "level": "进阶",
      "subtopic": "强化学习方法",
      "knowledgePoint": "直接策略评估",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "强化学习的直接策略评估如何估计给定策略的状态价值？",
      "answer": "运行给定策略，统计从该状态开始实际获得的回报，并以样本平均估计价值。",
      "explanation": "这类方法从完整回报样本学习，不要求环境转移模型。",
      "example": "多次访问状态后平均各次后续回报。",
      "tags": [
        "直接策略评估",
        "强化学习方法"
      ],
      "evidence": "source",
      "reference": "https://inst.eecs.berkeley.edu/~cs188/textbook/rl/mfl.html"
    },
    {
      "id": "rlmethod-006",
      "category": "foundations",
      "level": "进阶",
      "subtopic": "强化学习方法",
      "knowledgePoint": "时序差分更新",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "一步时序差分 TD(0) 如何利用 TD 误差更新给定策略下的状态价值？",
      "answer": "先计算误差 δ=r+γV(s′)−V(s)，再更新 V(s)←V(s)+αδ；真正终止时后继价值按零处理。",
      "explanation": "r 是本次奖励，α 是学习率，γ 是折扣因子。",
      "example": "奖励为 1、γ=0.9、后继价值为 2 时，非终止目标为 2.8。",
      "tags": [
        "时序差分更新",
        "强化学习方法"
      ],
      "evidence": "source",
      "reference": "https://inst.eecs.berkeley.edu/~cs188/textbook/rl/mfl.html",
      "supportingReferences": [
        {
          "id": "gymnasium-handling-time-limits",
          "title": "Gymnasium：处理终止与时间截断",
          "url": "https://gymnasium.farama.org/tutorials/gymnasium_basics/handling_time_limits/",
          "type": "官方教程",
          "evidence": "source"
        }
      ]
    },
    {
      "id": "rlmethod-007",
      "category": "foundations",
      "level": "进阶",
      "subtopic": "强化学习方法",
      "knowledgePoint": "自举估计",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "时序差分学习中的自举（bootstrapping）指什么？",
      "answer": "用当前已有的价值估计构造更新目标，再据此更新价值估计。",
      "explanation": "它不必等待整个回合的最终回报。",
      "example": "用当前的 V(s′) 更新 V(s)。",
      "tags": [
        "自举估计",
        "强化学习方法"
      ],
      "evidence": "source",
      "reference": "https://inst.eecs.berkeley.edu/~cs188/textbook/rl/mfl.html"
    },
