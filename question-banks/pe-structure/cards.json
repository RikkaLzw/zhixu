    {
      "id": "pe-003",
      "category": "vulnerabilities",
      "level": "入门",
      "subtopic": "文件结构",
      "knowledgePoint": "PE 入口点",
      "questionType": "概念与原理",
      "question": "PE 可选头中的 AddressOfEntryPoint 表示什么？",
      "answer": "它表示映像装入内存后入口点相对于映像基址的地址。",
      "explanation": "对程序映像而言该字段表示程序起始地址；它是 RVA 而非磁盘偏移。",
      "example": "静态分析时定位程序入口点所在的节。",
      "tags": [
        "PE 入口点",
        "文件结构"
      ],
      "evidence": "source",
      "reference": "https://learn.microsoft.com/en-us/windows/win32/debug/pe-format",
