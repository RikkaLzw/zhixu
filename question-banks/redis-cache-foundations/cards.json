    {
      "id": "rediscache-001",
      "category": "foundations",
      "level": "入门",
      "subtopic": "缓存与 Redis",
      "knowledgePoint": "字符串",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "Redis 7.2 的 String 类型存储的是什么？",
      "answer": "它存储字节序列，可以表示文本、数字或其他二进制数据。",
      "explanation": "字符串不要求内容一定是自然语言文本。",
      "example": "缓存一个序列化结果。",
      "tags": [
        "字符串",
        "缓存与 Redis"
      ],
      "evidence": "source",
      "reference": "https://redis.io/docs/latest/develop/data-types/"
    },
    {
      "id": "rediscache-002",
      "category": "foundations",
      "level": "入门",
      "subtopic": "缓存与 Redis",
      "knowledgePoint": "哈希",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "Redis 7.2 的 Hash 适合表示什么结构？",
      "answer": "它保存字段与值的映射，适合表示具有多个字段的记录。",
      "explanation": "一个 Redis key 可以对应一个包含多个字段的 Hash。",
      "example": "用用户 ID 作为 key，保存昵称和城市字段。",
      "tags": [
        "哈希",
        "缓存与 Redis"
      ],
      "evidence": "source",
      "reference": "https://redis.io/docs/latest/develop/data-types/"
    },
    {
      "id": "rediscache-003",
      "category": "foundations",
      "level": "入门",
      "subtopic": "缓存与 Redis",
      "knowledgePoint": "列表",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "Redis 7.2 的 List 保留什么顺序？",
      "answer": "它是按插入位置组织的字符串序列，可以从两端操作。",
      "explanation": "同一值可以出现多次。",
      "example": "用 LPUSH 和 RPOP 操作队列两端。",
      "tags": [
        "列表",
        "缓存与 Redis"
      ],
      "evidence": "source",
      "reference": "https://redis.io/docs/latest/develop/data-types/"
