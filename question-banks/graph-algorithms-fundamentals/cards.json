    {
      "id": "graphalg-002",
      "category": "foundations",
      "level": "入门",
      "subtopic": "图算法与并查集",
      "knowledgePoint": "遍历复杂度",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "使用邻接表且每个节点至多访问一次时，图的 BFS 或 DFS 的时间上界通常是多少？",
      "answer": "通常为 O(V+E)，其中 V 是节点数，E 是边数。",
      "explanation": "这包含访问节点与扫描邻接边的成本。",
      "example": "对稀疏图遍历时无需检查所有节点对。",
      "tags": [
        "图算法与并查集",
        "遍历复杂度"
      ],
      "evidence": "source",
      "reference": "https://cp-algorithms.com/graph/breadth-first-search.html"
    },
    {
      "id": "graphalg-003",
      "category": "foundations",
      "level": "入门",
      "subtopic": "图算法与并查集",
      "knowledgePoint": "路径恢复",
      "questionType": "概念与原理",
      "origin": "自行整理",
      "question": "无权图 BFS 找到终点后，如何恢复一条最少边数路径？",
      "answer": "发现新节点时记录其前驱，从终点沿前驱回溯到起点，再反转顺序。",
      "explanation": "前驱应记录 BFS 首次发现该节点时的来源。",
      "example": "由终点回溯得到起点到终点的路径。",
      "tags": [
        "图算法与并查集",
        "路径恢复"
      ],
      "evidence": "source",
      "reference": "https://cp-algorithms.com/graph/breadth-first-search.html"
